<?xml version="1.0" encoding="utf-8"?>
<!-- IIS / IIS Express (Visual Studio's built-in web server) has no .webp MIME type and answers 404.3 for the gallery
     images without this. GitHub Pages ignores this file. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>
